#!/bin/sh
#
# Run the system init scripts, silently on a normal boot.
#
# The console is part of the product: on the appliance path the TV must show
# nothing but the shell, and service chatter ("Starting syslogd: OK", the whole
# udhcpc negotiation) is stdout, not kernel output, so loglevel cannot suppress
# it. The "Mira (verbose console)" GRUB entry sets mira.debug=1 and gets the
# full output back - that entry existing is the reason this is conditional
# rather than unconditionally redirected.

if grep -q 'mira\.debug=1' /proc/cmdline 2>/dev/null; then
	exec /etc/init.d/rcS
fi

exec /etc/init.d/rcS >/dev/null 2>&1
